{
  "info": {
    "name": "London Essex Booking Checklist APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT"
    },
    {
      "key": "bookingId",
      "value": "69fcf4b1f72dbdb50e33b79b"
    },
    {
      "key": "courseId",
      "value": "YOUR_COURSE_ID"
    },
    {
      "key": "checklistVariant",
      "value": "am2"
    }
  ],
  "item": [
    {
      "name": "Get Admin Booking Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "bookings",
            "{{bookingId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const booking = json.data.booking;",
              "",
              "pm.collectionVariables.set('courseId', booking.course.id);",
              "pm.collectionVariables.set(",
              "  'checklistVariant',",
              "  booking.checklistVariantMetadata?.checklistVariant ||",
              "    booking.checklistVariant ||",
              "    booking.course.assessmentVariant ||",
              "    'am2'",
              ");",
              "",
              "pm.test('Booking fetched', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Only one checklist variant exists in booking flow', function () {",
              "  const variants = booking.checklistFlow?.availableVariants || [];",
              "  pm.expect(variants.length).to.eql(1);",
              "  pm.expect(variants[0].variant).to.eql(pm.collectionVariables.get('checklistVariant'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unified Checklist Flow",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/checklist-flow?courseId={{courseId}}&variant={{checklistVariant}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "checklist-flow"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}"
            },
            {
              "key": "variant",
              "value": "{{checklistVariant}}"
            }
          ]
        }
      }
    },
    {
      "name": "AM2 Checklist Flow",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/am2-checklist-flow?courseId={{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "am2-checklist-flow"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}"
            }
          ]
        }
      }
    },
    {
      "name": "AM2E Checklist Flow",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/am2e-checklist-flow?courseId={{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "am2e-checklist-flow"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}"
            }
          ]
        }
      }
    },
    {
      "name": "AM2E V1 Checklist Flow",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/am2e-v1-checklist-flow?courseId={{courseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "am2e-v1-checklist-flow"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}"
            }
          ]
        }
      }
    }
  ]
}
