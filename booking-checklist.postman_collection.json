    {
      "name": "Course Variation Pricing",
      "item": [
        {
          "name": "Find AM2 Course With Variant Prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/courses?page=1&limit=10&search={{am2CourseSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "courses"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "{{am2CourseSlug}}" }
              ]
            },
            "description": "Public course-admin list endpoint. Finds the am2-assessment-preparation course. Only this course returns assessmentVariantPricing with editable AM2, AM2E, and AM2E V1 prices."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Courses listed', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Courses array returned', () => pm.expect(json.data && json.data.courses).to.be.an('array'));",
                  "const courses = (json.data && json.data.courses) || [];",
                  "const course = courses.find((item) => item.slug === pm.collectionVariables.get('am2CourseSlug')) || courses[0];",
                  "if (course) {",
                  "  pm.collectionVariables.set('courseId', course.id);",
                  "}",
                  "pm.test('AM2 course supports variant pricing', () => {",
                  "  pm.expect(course).to.be.an('object');",
