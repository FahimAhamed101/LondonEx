{
  "info": {
    "name": "London Essex Flow APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "frontendUrl", "value": "http://localhost:3000" },
    { "key": "userToken", "value": "YOUR_USER_JWT" },
    { "key": "adminToken", "value": "YOUR_ADMIN_JWT" },
    { "key": "bookingId", "value": "YOUR_BOOKING_ID" },
    { "key": "courseId", "value": "YOUR_COURSE_ID" },
    { "key": "providerSignatureToken", "value": "TOKEN_FROM_REQUEST_RESPONSE_OR_EMAIL_LINK" },
    { "key": "documentType", "value": "full_certificate" },
    { "key": "documentFilePath", "value": "" },
    { "key": "signatureFilePath", "value": "" },
    { "key": "trainingProviderEmail", "value": "provider@example.com" },
    { "key": "trainingProviderName", "value": "Training Provider" },
    { "key": "candidateId", "value": "YOUR_CANDIDATE_BOOKING_ID" },
    { "key": "legalPageSlug", "value": "terms-and-conditions" },
    { "key": "legalPageSectionId", "value": "YOUR_LEGAL_PAGE_SECTION_ID" },
    { "key": "courseAssessmentVariant", "value": "am2" },
    { "key": "editableCoursePrice", "value": "885" },
    { "key": "am2CoursePrice", "value": "885" },
    { "key": "am2eCoursePrice", "value": "965" },
    { "key": "am2eV1CoursePrice", "value": "1235" }
  ],
  "item": [
    {
      "name": "Training Provider Signature Flow",
      "item": [
        {
          "name": "Get Booking Signatures Screen",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/flow/signatures",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "flow", "signatures"]
            },
            "description": "Authenticated learner endpoint. Returns candidate and training provider signature state plus the request action API URL."
          }
        },
        {
          "name": "Request Training Provider Signature Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainingProviderEmail\": \"{{trainingProviderEmail}}\",\n  \"trainingProviderName\": \"{{trainingProviderName}}\",\n  \"subject\": \"Please add your training provider signature\",\n  \"message\": \"Hello,\\n\\nI have completed my registration form and require your signature as my training provider to finalize the process.\\n\\nPlease review my details and provide your signature.\\n\\nThank you.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/flow/signatures/training-provider/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "flow", "signatures", "training-provider", "request"]
            },
            "description": "Sends an email to the trainingProviderEmail. The email link opens {{frontendUrl}}/provider-signature/{token}. If SMTP fails, the API returns 502 with data.link so you can still copy the token and test the provider upload page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Request handled', () => pm.expect([200, 502]).to.include(pm.response.code));",
                  "pm.test('Has signature link when request is saved', () => pm.expect(json.data && json.data.link).to.be.a('string'));",
                  "if (json.data && json.data.link) {",
                  "  const token = json.data.link.split('/').filter(Boolean).pop();",
                  "  pm.collectionVariables.set('providerSignatureToken', token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Provider Signature Upload Page Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/provider-signature/{{providerSignatureToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "provider-signature", "{{providerSignatureToken}}"]
            },
            "description": "Public endpoint used by the provider link. Returns booking/provider details and, after submit, the saved signature image in data.screen.signature.previewUrl/imageUrl/downloadUrl."
          }
        },
        {
          "name": "Submit Provider Signature - Drawn JSON",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signatureType\": \"draw\",\n  \"signatureData\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADElEQVR42mP8z8AARQAFAgH+AX+1AAAAAElFTkSuQmCC\",\n  \"fileName\": \"training-provider-signature.png\",\n  \"signerName\": \"{{trainingProviderName}}\",\n  \"signerEmail\": \"{{trainingProviderEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/provider-signature/{{providerSignatureToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "provider-signature", "{{providerSignatureToken}}"]
            },
            "description": "Public endpoint. Uploads the drawn signatureData image to Cloudinary, saves the Cloudinary URL, and returns it in data.screen.signature.previewUrl."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Drawn signature submitted', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Submitted Cloudinary signature URL returned', () => pm.expect(json.data && json.data.screen && json.data.screen.signature && json.data.screen.signature.previewUrl).to.match(/^https?:\\/\\//));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Provider Signature - Upload File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "signatureType", "value": "upload", "type": "text" },
                { "key": "signerName", "value": "{{trainingProviderName}}", "type": "text" },
                { "key": "signerEmail", "value": "{{trainingProviderEmail}}", "type": "text" },
                { "key": "file", "src": "{{signatureFilePath}}", "type": "file" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/provider-signature/{{providerSignatureToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "provider-signature", "{{providerSignatureToken}}"]
            },
            "description": "Public endpoint. Use multipart/form-data and let Postman set Content-Type. File fields accepted by the API: file, image, signature, candidateSignature. Uploads to Cloudinary and returns the Cloudinary URL in data.screen.signature.previewUrl."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Uploaded signature handled', () => pm.expect([200, 400]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Submitted Cloudinary signature URL returned', () => pm.expect(json.data && json.data.screen && json.data.screen.signature && json.data.screen.signature.previewUrl).to.match(/^https?:\\/\\//));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Previously Added APIs",
      "item": [
        {
          "name": "Course Catalog With Remaining Seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/screen/catalog?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "screen", "catalog"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Returns catalog cards with totalSeats, bookedSeats, remainingSeats, and capacity."
          }
        },
        {
          "name": "Get Booking Documents Flow",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/flow/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "flow", "documents"]
            }
          }
        },
        {
          "name": "Upload Booking Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "src": "{{documentFilePath}}", "type": "file" },
                { "key": "documentType", "value": "{{documentType}}", "type": "text" },
                { "key": "documentLabel", "value": "", "type": "text", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/flow/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "flow", "documents", "upload"]
            },
            "description": "Uploads/replaces a required document. Valid documentType values are returned by the documents flow."
          }
        },
        {
          "name": "Admin Booking Detail With Document URLs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "bookings", "{{bookingId}}"]
            },
            "description": "Returns uploaded document URLs in data.booking.documents.items, uploadedDocuments.items, and checklistFlow.flow.documents.uploadedItems. Candidate and training provider signatures are returned as Cloudinary URLs in data.booking.signatures and as signature document cards in data.booking.documents.signatureItems and data.booking.uploadedDocuments.signatureItems."
          }
        },
        {
          "name": "Send Single Candidate Reminder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/candidates/{{candidateId}}/reminder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "candidates", "{{candidateId}}", "reminder"]
            },
            "description": "Sends a progress reminder email to one candidate booking row. If SMTP fails, the API returns 502 with data.emailDelivery.message explaining the SMTP issue."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Reminder request handled', () => pm.expect([200, 400, 502]).to.include(pm.response.code));",
                  "if (pm.response.code === 502) {",
                  "  pm.test('SMTP failure reason is returned', () => pm.expect(json.data && json.data.emailDelivery && json.data.emailDelivery.message).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Stuck Candidate Reminders Under 50 Percent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/candidates/stuck/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "candidates", "stuck", "reminders"]
            },
            "description": "Sends reminder emails to all non-cancelled candidates whose progress is less than 50%. If SMTP fails for all matched candidates, the API returns 502 and each failed item includes reason and emailDelivery.message."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Bulk reminder request handled', () => pm.expect([200, 502]).to.include(pm.response.code));",
                  "if (pm.response.code === 502) {",
                  "  pm.test('Bulk SMTP failures include reasons', () => pm.expect(json.data && json.data.failed && json.data.failed.length).to.be.above(0));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Legal Page Settings APIs",
      "item": [
        {
          "name": "Public Legal Page By Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/settings/public/legal-pages/{{legalPageSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "public", "legal-pages", "{{legalPageSlug}}"]
            },
            "description": "Public endpoint. No token required. Valid slugs and aliases include terms-and-conditions, terms, terms-conditions, privacy-policy, and privacy. Returns only published pages and visible sections in data.page.sections."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Public legal page fetched', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Page payload returned', () => pm.expect(json.data && json.data.page && json.data.page.slug).to.be.a('string'));",
                  "if (json.data && json.data.page && json.data.page.slug) {",
                  "  pm.collectionVariables.set('legalPageSlug', json.data.page.slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Admin Legal Pages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages"]
            },
            "description": "Admin endpoint. Requires Bearer {{adminToken}}. Creates default terms and privacy pages if missing, then returns data.pages and data.tabs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Admin legal pages listed', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Pages array returned', () => pm.expect(json.data && json.data.pages).to.be.an('array'));",
                  "if (json.data && Array.isArray(json.data.pages) && json.data.pages[0]) {",
                  "  pm.collectionVariables.set('legalPageSlug', json.data.pages[0].slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Admin Legal Page Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}"]
            },
            "description": "Admin endpoint. Returns the dashboard-ready legal page settings screen in data.screen and the editable page in data.page. Use a section id from data.page.sections[*].sectionId for section update, visibility, and delete requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Admin legal page fetched', () => pm.expect(pm.response.code).to.equal(200));",
                  "const page = json.data && json.data.page;",
                  "if (page && page.slug) { pm.collectionVariables.set('legalPageSlug', page.slug); }",
                  "if (page && Array.isArray(page.sections) && page.sections[0]) {",
                  "  pm.collectionVariables.set('legalPageSectionId', page.sections[0].sectionId || page.sections[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Legal Page Content",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Terms & Conditions\",\n  \"subtitle\": \"Edit the title, introduction, and section copy shown on the public terms page.\",\n  \"category\": \"LEGAL\",\n  \"isPublished\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}"]
            },
            "description": "Admin endpoint. Updates page-level fields. Optional fields: title, subtitle, category, isPublished. You can also send sections as an array, but that replaces the page sections list, so use the section-specific APIs for safer edits."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Legal page content updated', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Updated page returned', () => pm.expect(json.data && json.data.page && json.data.page.slug).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Legal Page Section",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cancellation Policy\",\n  \"introduction\": \"Course places are subject to availability. Contact the team if you need to change a confirmed booking.\",\n  \"order\": 6,\n  \"isVisible\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}", "sections"]
            },
            "description": "Admin endpoint. Adds one section. Accepted aliases: title or heading; introduction, content, body, or description; isVisible or visible. A page can contain up to 20 sections."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Legal page section created', () => pm.expect(pm.response.code).to.equal(201));",
                  "const section = json.data && json.data.section;",
                  "if (section) {",
                  "  pm.collectionVariables.set('legalPageSectionId', section.sectionId || section.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Legal Page Section",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Cancellation Policy\",\n  \"introduction\": \"Updated section content for the selected legal page section.\",\n  \"order\": 3,\n  \"isVisible\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}/sections/{{legalPageSectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}", "sections", "{{legalPageSectionId}}"]
            },
            "description": "Admin endpoint. Partially updates a section. Send at least one editable field. Valid section ids are returned by Get Admin Legal Page Settings or Add Legal Page Section."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Legal page section updated', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Updated section returned', () => pm.expect(json.data && json.data.section).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Legal Page Section Visibility",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isVisible\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}/sections/{{legalPageSectionId}}/visibility",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}", "sections", "{{legalPageSectionId}}", "visibility"]
            },
            "description": "Admin endpoint. Sets visibility when isVisible or visible is supplied. If the body is empty, the API toggles the current visibility value."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Legal page section visibility updated', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Visibility returned', () => pm.expect(json.data && json.data.section && json.data.section.isVisible).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Legal Page Section",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/legal-pages/{{legalPageSlug}}/sections/{{legalPageSectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settings", "legal-pages", "{{legalPageSlug}}", "sections", "{{legalPageSectionId}}"]
            },
            "description": "Admin endpoint. Deletes one section and reindexes the remaining section order. Run Add Legal Page Section first if you want a disposable section for delete testing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Legal page section deleted', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Deleted section id returned', () => pm.expect(json.data && json.data.sectionId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Course VAT Support",
      "item": [
        {
          "name": "Get Admin Course With VAT Pricing",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "courses", "{{courseId}}"]
            },
            "description": "Admin endpoint. Returns data.course with pricing fields such as vatEnabled, vatIncluded, vatAmount, totalAmount, vatRate, vatPercentage, baseDisplayPrice, totalDisplayPrice, and displayPrice. VAT on example displayPrice: \u00a31,000 + VAT (\u00a31,200). VAT off example displayPrice: \u00a31,000."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Admin course fetched', () => pm.expect(pm.response.code).to.equal(200));",
                  "const pricing = json.data && json.data.course && json.data.course.pricing;",
                  "pm.test('VAT pricing fields returned', () => {",
                  "  pm.expect(pricing).to.be.an('object');",
                  "  pm.expect(pricing).to.have.property('displayPrice');",
