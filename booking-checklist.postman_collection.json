                  "  pm.expect(course.supportsAssessmentVariantPricing).to.equal(true);",
                  "  pm.expect(course.assessmentVariantPricing.prices).to.have.property('am2');",
                  "  pm.expect(course.assessmentVariantPricing.prices).to.have.property('am2e');",
                  "  pm.expect(course.assessmentVariantPricing.prices).to.have.property('am2e-v1');",
                  "});"
                ]
              }
            }
          ]
        },
